# Template only — placeholders, never real values.
# Copy to .env and fill in there. .env is gitignored; this file is not.

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Prefix the scheme with +psycopg2 for SQLAlchemy.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# --- Auth (M3) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Supabase Storage (M3/M4) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- Gemini, AI Product Assistant (M3) ---
GEMINI_API_KEY=

# --- Resend, inquiry notification emails (M3) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
